# Copie para .env somente para desenvolvimento local.
# Use uma URL de um banco MySQL de desenvolvimento/teste.
DATABASE_URL=mysql+pymysql://USUARIO:SENHA@HOST:3306/streaming_db?charset=utf8mb4

# Opcional em desenvolvimento. Em produção, SESSION_SECRET é obrigatória.
# Gere uma chave com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
APP_ENV=development

# Opcional: origens CORS separadas por vírgula quando o frontend estiver
# hospedado em outra origem. Deixe vazio se frontend e API forem same-origin.
CORS_ORIGINS=
